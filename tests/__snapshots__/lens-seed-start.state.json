 "startup": {
  "kind": "seed",
  "packId": "startup-sample",
  "packName": "Startup sample",
  "seedId": "salt-road",
  "title": "The Salt Road",
  "pitch": "An inland sea is drying up. Where the water retreats it leaves salt flats, stranded harbor towns and, eventually, a single road across the new desert: the only link between two peoples who once traded by boat. Whoever holds the Salt Road holds both shores. Will the road bind the peoples together, or become the line they fight over?",
  "notes": [
   {
    "question": "Why is the sea drying up?",
    "answers": [
     "A river that fed it was dammed or diverted upstream."
    ]
   },
   {
    "question": "Who lives on the two shores?",
    "answers": [
     "Two guilds of salt-cutters who share a grandmother."
    ]
   },
   {
    "question": "What does the salt mean to the people who cross it?",
    "answers": [
     "Wealth: salt is money.",
     "Memory: things the sea swallowed resurface as it retreats."
    ]
   }
  ],
  "bookends": {
   "start": {
    "title": "The last ferry",
    "text": "The last ferry makes its crossing before the water gets too shallow; its passengers are the first to walk home."
   },
   "end": {
    "title": "The long city",
    "text": "The peoples have merged, and the road has become one narrow city stretching across the old seabed."
   }
  },
  "bigPictureDraft": "As an inland sea dries to salt, a single road across its bed decides the fate of the peoples on either shore.",
  "note": "The road gives every Period a question to answer: who holds it now? To put the drying itself on the timeline, move the sea's retreat into the first Period instead of before it.",
  "palette": {
   "yes": [
    "Caravans and waystations"
   ],
   "no": [
    "Magic that makes water"
   ]
  }
 }
