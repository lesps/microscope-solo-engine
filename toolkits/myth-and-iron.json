  "groups": [
    {
      "id": "myth-and-iron",
      "name": "Myth and Iron",
      "description": "Gods, oaths and the coming of iron: histories told like old sagas."
    }
  ],
  "seeds": [
    {
      "id": "toolkit.myth.iron-gift",
      "title": "The Iron Gift",
      "group": "myth-and-iron",
      "ruleset": "lens",
      "pitch": "In the age of bronze the gods kept one secret: how to draw iron out of stone. Then one of them gave it away. Mortals with iron no longer had to beg the gods for anything, and the old order began to crack. Did the gift free humanity, or only teach it to make better weapons?",
      "bigPicture": "When a god gives mortals the secret of iron, the age of the gods begins to end.",
      "questions": [
        {
          "id": "giver",
          "text": "Which god gave the secret away?",
          "pick": "one",
          "allowCustom": true,
          "options": [
            {
              "id": "smith",
              "text": "The smith of the gods, out of pity."
            },
            {
              "id": "trickster",
              "text": "A trickster, to spite the others."
            },
            {
              "id": "dying",
              "text": "A dying god, as a last act."
            },
            {
              "id": "lover",
              "text": "A god in love with a mortal."
            }
          ]
        },
        {
          "id": "punishment",
          "text": "What did the other gods do to the giver?",
          "pick": "one",
          "allowCustom": true,
          "options": [
            {
              "id": "chained",
              "text": "Chained them beneath a mountain."
            },
            {
              "id": "mortal",
              "text": "Made them mortal."
            },
            {
              "id": "erased",
              "text": "Struck their name from every song."
            },
            {
              "id": "nothing",
              "text": "Nothing. They never found out who it was."
            }
          ]
        },
        {
          "id": "first",
          "text": "Who used iron first?",
          "pick": "oneOrTwo",
          "allowCustom": true,
          "options": [
            {
              "id": "farmers",
              "text": "Farmers, for ploughs."
            },
            {
              "id": "raiders",
              "text": "Raiders, for swords."
            },
            {
              "id": "priests",
              "text": "Priests, to bind a god."
            },
            {
              "id": "healers",
              "text": "Healers, for knives that do not shatter."
            }
          ]
        }
      ],
      "startBookend": {
        "text": "How does the history begin?",
        "options": [
          {
            "id": "quench",
            "title": "The first quenching",
            "text": "The first iron blade is quenched in a mortal forge, and every god feels it."
          },
          {
            "id": "trial",
            "title": "The trial of the giver",
            "text": "The giver stands before the assembled gods and will not say why."
          },
          {
            "id": "theft",
            "title": "The theft at the forge",
            "text": "A mortal sneaks into the forge of the gods and watches how it is done."
          }
        ]
      },
      "endBookend": {
        "text": "How does the history end?",
        "options": [
          {
            "id": "abandoned",
            "title": "The empty temples",
            "text": "The last temple is abandoned, and no one remembers who it was built for."
          },
          {
            "id": "equals",
            "title": "One table",
            "text": "Gods and mortals sit at one table, as equals, for the first time."
          },
          {
            "id": "rust",
            "title": "Rust",
            "text": "The iron rusts away, the secret is forgotten, and the gods return."
          }
        ]
      },
      "palette": {
        "yes": ["Forges as temples", "Gods with human appetites"],
        "no": ["Gunpowder"]
      },
      "note": "Let iron change something in every Period: war, farming, worship, trade. The gods are characters, not scenery; give them Scenes."
    },
    {
      "id": "toolkit.myth.drowned-hall",
      "title": "The Drowned Hall",
      "group": "myth-and-iron",
      "ruleset": "lens",
      "pitch": "A sea-king swore an oath to the ocean: give my people safe harbor and you may have my hall when I die. He died, his heirs refused, and the sea has been taking its due ever since, one tide at a time. Will the bloodline keep the oath, break it for good, or find a third way?",
      "bigPicture": "A royal bloodline refuses to pay the sea what its founder promised, and the sea keeps coming to collect.",
      "questions": [
        {
          "id": "sworn",
          "text": "What did the king swear by?",
          "pick": "one",
          "allowCustom": true,
          "options": [
            {
              "id": "ring",
              "text": "An oath-ring of drowned gold."
            },
            {
              "id": "blood",
              "text": "His own blood, poured into the surf."
            },
            {
              "id": "child",
              "text": "The name of his firstborn."
            }
          ]
        },
        {
          "id": "refused",
          "text": "Who first refused to pay?",
          "pick": "one",
          "allowCustom": true,
          "options": [
            {
              "id": "heir",
              "text": "His heir, who never believed in the oath."
            },
            {
              "id": "queen",
              "text": "His widow, who wanted the hall for herself."
            },
            {
              "id": "priest",
              "text": "A priest, who said the sea had no right to it."
            }
          ]
        },
        {
          "id": "sea",
          "text": "How does the sea collect?",
