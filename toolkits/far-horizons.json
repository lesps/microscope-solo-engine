  "seeds": [
    {
      "id": "toolkit.far.long-signal",
      "title": "The Long Signal",
      "group": "far-horizons",
      "ruleset": "lens",
      "pitch": "A radio telescope picks up a signal from a star eighty light-years away. It is unmistakably artificial, and it is a reply to a message humanity has not sent yet. Deciding what to send takes generations; the answer takes longer. Will the signal bring humanity together, or tear it apart over what to say?",
      "bigPicture": "Humanity receives a reply to a message it has not sent yet, and spends centuries deciding what to say.",
      "questions": [
        {
          "id": "signal",
          "text": "What is in the signal?",
          "pick": "one",
          "allowCustom": true,
          "options": [
            {
              "id": "math",
              "text": "A mathematical greeting."
            },
            {
              "id": "map",
              "text": "A map with one point marked."
            },
            {
              "id": "warning",
              "text": "A warning."
            },
            {
              "id": "voice",
              "text": "A voice that sounds human."
            }
          ]
        },
        {
          "id": "control",
          "text": "Who controls the reply?",
          "pick": "one",
          "allowCustom": true,
          "options": [
            {
              "id": "nation",
              "text": "One nation, which found it first."
            },
            {
              "id": "corp",
              "text": "The corporation that owns the telescope."
            },
            {
              "id": "council",
              "text": "A council of every world."
            },
            {
              "id": "noone",
              "text": "No one. Everyone sends their own reply."
            }
          ]
        },
        {
          "id": "belief",
          "text": "What do people come to believe about the senders?",
          "pick": "oneOrTwo",
          "allowCustom": true,
          "options": [
            {
              "id": "future",
              "text": "They are us, from the future."
            },
            {
              "id": "gods",
              "text": "They are gods."
            },
            {
              "id": "dead",
              "text": "They are long dead."
            },
            {
              "id": "coming",
              "text": "They are already on their way."
            }
          ]
        }
      ],
      "startBookend": {
        "text": "How does the history begin?",
        "options": [
          {
            "id": "night-shift",
            "title": "An ordinary night shift",
            "text": "The signal is detected on an ordinary night shift, by someone who almost ignores it."
          },
          {
            "id": "announcement",
            "title": "The announcement",
            "text": "The signal is announced to the world, and nobody sleeps."
          }
        ]
      },
      "endBookend": {
        "text": "How does the history end?",
        "options": [
          {
            "id": "arrival",
            "title": "The senders arrive",
            "text": "The senders arrive."
          },
          {
            "id": "too-late",
            "title": "No one to hear",
            "text": "Humanity's reply finally reaches the star, and there is no one left to hear it."
          },
          {
            "id": "second",
            "title": "A second signal",
            "text": "A second signal arrives, from much closer."
          }
        ]
      },
      "palette": {
        "yes": ["Messages that take years to arrive"],
        "no": ["Faster-than-light travel"]
      },
      "note": "Light is slow: let decades pass between Periods. Turn on Faster-than-light travel only if you want the history to catch up with the signal."
    },
    {
      "id": "toolkit.far.seedship",
      "title": "Seedship",
      "group": "far-horizons",
      "ruleset": "lens",
      "pitch": "A seedship carries ten thousand sleepers and a crew who will live and die aboard it on the way to a world none of them will see. The voyage takes four hundred years. The history is the ship's: the crew's generations, the sleepers in their vaults, and what is left of the mission when the ship arrives.",
      "bigPicture": "A generation ship crosses four centuries of dark, and its crew forgets, remembers and remakes why it was sent.",
      "questions": [
        {
          "id": "why",
          "text": "Why did the ship leave Earth?",
          "pick": "one",
          "allowCustom": true,
          "options": [
            {
              "id": "dying",
              "text": "Earth was dying."
            },
            {
              "id": "faith",
              "text": "A faith sent it, as a pilgrimage."
            },
            {
              "id": "exile",
              "text": "Its passengers were exiles."
            },
            {
              "id": "choice",
              "text": "Because someone could."
            }
          ]
        },
        {
          "id": "mind",
          "text": "Who runs the ship?",
          "pick": "one",
          "allowCustom": true,
          "options": [
            {
              "id": "captains",
              "text": "Hereditary captains."
            },
            {
              "id": "mind",
              "text": "The ship's mind."
            },
            {
              "id": "vote",
              "text": "Everyone, by vote."
            }
          ]
        }
      ],
      "startBookend": {
        "text": "How does the history begin?",
        "options": [
          {
            "id": "launch",
            "title": "Launch",
            "text": "The seedship leaves orbit, and the first crew watches Earth shrink to a point."
          },
          {
            "id": "waking",
            "title": "The first waking",
            "text": "The second generation of crew is born and never sees a sky."
          }
        ]
      },
      "endBookend": {
        "text": "How does the history end?",
        "options": [
          {
