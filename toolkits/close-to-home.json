  "seeds": [
    {
      "id": "toolkit.home.alder-street",
      "title": "The House on Alder Street",
      "group": "close-to-home",
      "ruleset": "chronicle",
      "pitch": "A house is built at the end of a dirt road that will one day be called Alder Street. Over a hundred years it holds four families, two fires, a wedding in the back garden and a death in the front room. The history is the house's: who lives there, what they change, and what it remembers.",
      "subject": {
        "name": "The house on Alder Street",
        "description": "A two-storey wooden house at the end of the street, with a deep porch and an attic nobody clears out.",
        "traits": [
          "Drafty",
          "Full of other people's things",
          "Always has a dog",
          "Too big for one person"
        ]
      },
      "questions": [
        {
          "id": "builder",
          "text": "Who built the house?",
          "pick": "one",
          "allowCustom": true,
          "options": [
            {
              "id": "couple",
              "text": "A young couple, with their own hands."
            },
            {
              "id": "mill",
              "text": "The mill, for its foreman."
            },
            {
              "id": "widow",
              "text": "A widow, with her husband's insurance."
            }
          ]
        },
        {
          "id": "attic",
          "text": "What is in the attic?",
          "pick": "oneOrTwo",
          "allowCustom": true,
          "options": [
            {
              "id": "letters",
              "text": "A box of letters no one has read."
            },
            {
              "id": "trunk",
              "text": "A locked trunk."
            },
            {
              "id": "nothing",
              "text": "Nothing, and that is strange."
            },
            {
              "id": "ghost",
              "text": "Someone who never left."
            }
          ]
        }
      ],
      "startBookend": {
        "text": "How does the history begin?",
        "options": [
          {
            "id": "frame",
            "title": "The frame goes up",
            "text": "Neighbors gather to raise the frame of the house in a single day."
          },
          {
            "id": "keys",
            "title": "The first keys",
            "text": "The first family is handed the keys to a house that smells of fresh paint."
          }
        ]
      },
      "endBookend": {
        "text": "How does the history end?",
        "options": [
          {
            "id": "demolished",
            "title": "The house comes down",
            "text": "The house is demolished, and a neighbor saves the porch rail."
          },
          {
            "id": "returned",
            "title": "Back in the family",
            "text": "A great-grandchild of the first family buys the house back."
          },
          {
            "id": "empty",
            "title": "An empty house",
            "text": "The last owner moves out, and the house stands empty and waiting."
          }
        ]
      },
      "palette": {
        "yes": ["Old houses", "Letters and photographs"],
        "no": []
      },
      "note": "Each Period's Anchor is whoever lives in the house then. Change a trait every time the house changes hands."
    },
    {
      "id": "toolkit.home.last-orders",
      "title": "Last Orders",
      "group": "close-to-home",
      "ruleset": "lens",
      "pitch": "The diner on Route 9 has been open since before the interstate. It has seen the town boom, bust and boom again, and the same six regulars have sat at the counter for decades, or their children have. Tonight it closes for good. The history is everything that happened before the last coffee was poured.",
      "bigPicture": "A small-town diner outlives the town's good years and bad, until the night it closes for good.",
      "questions": [
        {
          "id": "why",
          "text": "Why is the diner closing?",
          "pick": "one",
          "allowCustom": true,
          "options": [
            {
              "id": "sold",
              "text": "The land has been sold."
            },
            {
              "id": "retire",
              "text": "The owner is retiring, and no one will take it on."
            },
            {
              "id": "road",
              "text": "The new road bypasses the town."
            },
            {
              "id": "secret",
              "text": "No one will say."
            }
          ]
        },
        {
          "id": "regulars",
          "text": "Who are the regulars?",
          "pick": "oneOrTwo",
          "allowCustom": true,
          "options": [
            {
              "id": "farmers",
              "text": "Farmers before dawn."
            },
            {
              "id": "shift",
              "text": "Factory workers coming off shift."
            },
            {
              "id": "teens",
              "text": "Teenagers with nowhere else to go."
            },
            {
              "id": "widowers",
              "text": "Widowers who don't want to eat alone."
            }
          ]
        }
      ],
      "startBookend": {
        "text": "How does the history begin?",
        "options": [
          {
            "id": "opening",
            "title": "Opening day",
            "text": "The diner opens with six stools, one cook and a pie on the counter."
          },
          {
            "id": "bought",
            "title": "Bought on a bet",
            "text": "The diner changes hands in a card game."
          }
        ]
      },
      "endBookend": {
        "text": "How does the history end?",
        "options": [
          {
            "id": "last-cup",
            "title": "The last coffee",
            "text": "The last coffee is poured, and the regulars refuse to leave."
          },
          {
            "id": "reopens",
            "title": "Under new management",
            "text": "The diner reopens under a new name, and the regulars come anyway."
          }
        ]
      },
